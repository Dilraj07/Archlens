      "target": "cassandra_db"
    },
    {
      "id": "e_gateway_recs",
      "source": "api_gateway",
      "target": "recommendation_svc"
    },
    {
      "id": "e_recs_cache",
      "source": "recommendation_svc",
      "target": "redis_recs"
    },
    {
      "id": "e_playback_s3",
      "source": "playback_service",
      "target": "s3_video_store"
    }
